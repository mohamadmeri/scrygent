# SCRYGENT CONFIGURATION ENVIRONMENT

# API CREDENTIALS ---
GROQ_API_KEY="gsk_your_groq_key_here"
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"
QDRANT_URL="https://your-cluster-url.qdrant.tech"
QDRANT_API_KEY="your_qdrant_api_key_here"
HF_API_TOKEN="hf_your_huggingface_token_here"

# LLM ROUTING & PARAMETERS
# Choose: "openrouter" or "groq"
SCRYGENT_LLM_PROVIDER="openrouter"
SCRYGENT_LLM_TEMPERATURE="0.0"
SCRYGENT_LLM_SEED="42"

# OPENROUTER MODELS
# Reasoning Model: Deep logic parsing (Pass 1, Reporter)
OPENROUTER_REASONING_MODEL="openai/gpt-oss-120b:free"
# Formatting Model: Fast JSON translation (Pass 2, Correction Chain)
OPENROUTER_FORMATTING_MODEL="google/gemma-4-26b-a4b-it:free"

# GROQ MODELS
GROQ_REASONING_MODEL="llama-3.3-70b-versatile"
GROQ_FORMATTING_MODEL="llama-3.1-8b-instant"

# STRUCTURED OUTPUT METHODS
# Supported options: "json_mode", "function_calling", or leave blank for default
SCRYGENT_EMISSION_METHOD="json_mode"
SCRYGENT_REPORTER_METHOD="json_mode"

# RESILIENCE & PACING
# Set to "true" to enable the LangChain Runnable pacer (critical for free tiers)
SCRYGENT_PACE_REQUESTS="true"
# OpenRouter Free Tier usually requires 6.1s (10 RPM). Groq requires 2.1s (30 RPM).
SCRYGENT_PACE_INTERVAL="6.1"
SCRYGENT_MAX_RETRIES="3"

# SYSTEM COMPONENTS
SCRYGENT_MEMORY_ENABLED="true"
HF_EMBEDDING_API_URL="https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction"

# ENGINE LIMITS
# Maximum number of data points rendered in a single WebGL plot
SCRYGENT_MAX_PLOT_POINTS="5000"
# Maximum number of columns fully evaluated in the Profiler Node
SCRYGENT_MAX_DETAILED_COLUMNS="15"

# LANGSMITH TRACING (Optional)
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="lsv2_pt_your_key_here"
LANGCHAIN_PROJECT="scrygent-production"