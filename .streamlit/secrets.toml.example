# SCRYGENT CONFIGURATION ENVIRONMENT

# API CREDENTIALS
GROQ_API_KEY = "gsk_your_groq_key_here"
OPENROUTER_API_KEY = "sk-or-v1-your_openrouter_key_here"
QDRANT_URL = "https://your-cluster-url.qdrant.tech"
QDRANT_API_KEY = "your_qdrant_api_key_here"
HF_API_TOKEN = "hf_your_huggingface_token_here"

# LLM ROUTING & PARAMETERS
SCRYGENT_LLM_PROVIDER = "groq"
SCRYGENT_LLM_TEMPERATURE = "0.0"
SCRYGENT_LLM_SEED = "42"

# MODELS (Set to Groq defaults for deployment)
GROQ_REASONING_MODEL = "llama-3.3-70b-versatile"
GROQ_FORMATTING_MODEL = "llama-3.1-8b-instant"

# STRUCTURED OUTPUT METHODS
SCRYGENT_EMISSION_METHOD = "json_mode"
SCRYGENT_REPORTER_METHOD = "json_mode"

# RESILIENCE & PACING
SCRYGENT_PACE_REQUESTS = "true"
SCRYGENT_PACE_INTERVAL = "2.1"
SCRYGENT_MAX_RETRIES = "3"

# SYSTEM COMPONENTS
SCRYGENT_MEMORY_ENABLED = "true"
HF_EMBEDDING_API_URL = "https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction"

# ENGINE LIMITS
SCRYGENT_MAX_PLOT_POINTS = "5000"
SCRYGENT_MAX_DETAILED_COLUMNS = "15"

# LANGSMITH TRACING (Enabled for deployment monitoring)
LANGCHAIN_TRACING_V2 = "true"
LANGCHAIN_API_KEY = "lsv2_pt_your_key_here"
LANGCHAIN_PROJECT = "scrygent-production"